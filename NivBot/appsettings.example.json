{
  // Copy to appsettings.json (gitignored) and fill in. Every value can also be set with an environment
  // variable, using __ for nesting: Discord__Token, ConnectionStrings__Goodplace, Tasks__MinHours, ...
  "Discord": {
    "Token": ""
  },
  "ConnectionStrings": {
    "Goodplace": "Host=localhost;Port=5432;Database=postgres;Username=postgres;Password=postgres"
  },
  "Osrs": {
    // Any account on the hiscores, /syncactivities reads the activity list from it
    "ReferencePlayer": "niv lem"
  },
  "Temple": {
    // TempleOSRS group: collection logs are synced from it every role sync, and Temple competitions are created for it
    "GroupId": 0,
    "GroupKey": ""
  },
  "WiseOldMan": {
    // Wise Old Man group and its verification code, needed for WOM competitions
    "GroupId": 0,
    "GroupVerificationCode": "",
    // Optional, leave empty without a key (WOM rejects unknown keys)
    "ApiKey": ""
  },
  "Tasks": {
    // Tasks are sized to take a random time between MinHours and MaxHours
    "MinHours": 1.5,
    "MaxHours": 2.5,
    // The seeded Wise Old Man rates are efficient-play rates, these scale them to casual play
    "SkillRateMultiplier": 0.5,
    "BossRateMultiplier": 0.5,
    "PointsPerTask": 5,
    "CurrencyPerTask": 5,
    // One skip per task type per cooldown (d.hh:mm:ss)
    "SkipCooldown": "1.00:00:00",
    "MaxSkillBlocks": 3,
    "MaxBossBlocks": 10,
    // Replaces the default list when set. Farming is excluded because its rates are tree runs (time-gated)
    "ExcludedSkills": [ "Attack", "Defence", "Strength", "Hitpoints", "Ranged", "Prayer", "Magic", "Farming" ]
  },
  "Roles": {
    // How often every member is checked against the hiscores (hh:mm:ss). 00:00:00 = only with /roles sync
    "SyncInterval": "06:00:00",
    "DelayBetweenMembers": "00:00:01",
    // Channel id for the "close to a role" posts, 0 = no posts
    "AnnouncementChannelId": 0
  },
  "Competitions": {
    // Points (and currency) for 1st, 2nd, 3rd...
    "Rewards": [ 30, 20, 10 ],
    // Wait this long after the end before reading the results
    "ResultsDelay": "00:30:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
